#!/usr/bin/env bash
# Installs Neovim's vim.pack plugins and moves them to the commits in the lockfile,
# then updates the Tree-sitter parsers to the versions that nvim-treesitter commit expects.
# Re-runs whenever the lockfile changes: {{ include "dot_config/nvim/nvim-pack-lock.json" | sha256sum }}
set -euo pipefail

nvim --headless -c "lua vim.pack.update(nil, { target = 'lockfile', force = true })" -c qa
if command -v tree-sitter >/dev/null 2>&1 && (command -v cc >/dev/null 2>&1 || command -v gcc >/dev/null 2>&1); then
    nvim --headless -c "lua require('nvim-treesitter').update():wait(300000)" -c qa
fi
