case $- in
    *i*) ;;
      *) return ;;
esac

[ -r /etc/bashrc ] && . /etc/bashrc
[ -r /etc/bash.bashrc ] && . /etc/bash.bashrc

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

for _f in env.sh aliases.sh functions.sh; do
    _path="${XDG_CONFIG_HOME:-$HOME/.config}/shell/$_f"
    [ -r "$_path" ] && . "$_path"
done
unset _f _path

for rc in "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc.d"/*.sh; do
    [ -r "$rc" ] && . "$rc"
done
unset rc
