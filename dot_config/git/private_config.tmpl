{{- $opSign := lookPath "op-ssh-sign" -}}
{{- if and (not $opSign) (stat "/opt/1Password/op-ssh-sign") -}}
{{-   $opSign = "/opt/1Password/op-ssh-sign" -}}
{{- end -}}
[gpg]
	format = ssh
[gpg "ssh"]
{{- if $opSign }}
	program = {{ $opSign }}
{{- end }}
	allowedSignersFile = ~/.config/git/allowed_signers
{{- if $opSign }}
[commit]
	gpgsign = true
[tag]
	gpgsign = true
{{- end }}
[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE3zzd7c8dpozDTV9MRJ5o1bsuaGLdfqzxt8w9DgSVWU
	name = Yury A.
	email = Atnazhev.Yu@pm.me
[core]
{{- if lookPath "emacsclient" }}
	editor = ec
{{- else if lookPath "nvim" }}
	editor = nvim
{{- else if lookPath "vim" }}
	editor = vim
{{- end }}
{{- if lookPath "delta" }}
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	side-by-side = true
	navigate = true  # use n and N to move between diff sections
	dark = true      # or light = true, or omit for auto-detection
{{- end }}
[merge]
	conflictStyle = zdiff3
{{- if lookPath "emacsclient" }}
	tool = ediff
[mergetool "ediff"]
	cmd = emacsclient -t -a "" --eval "(ediff-merge-files-with-ancestor \"$LOCAL\" \"$REMOTE\" \"$BASE\" nil \"$MERGED\")"
{{- else if lookPath "nvim" }}
	tool = nvimdiff
{{- else if lookPath "vim" }}
	tool = vimdiff
{{- end }}
[mergetool]
	keepBackup = false
