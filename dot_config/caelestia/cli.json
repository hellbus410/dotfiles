{
    "toggles": {
        "communication": {
            "discord": { "enable": false },
            "whatsapp": { "enable": false },
            "vesktop": {
                "enable": true,
                "match": [{ "class": "vesktop" }],
                "command": ["vesktop"],
                "move": true
            }
        },
        "telegram": {
            "telegram": {
                "enable": true,
                "match": [{ "class": "org.telegram.desktop" }],
                "command": ["Telegram"],
                "move": true
            }
        },
        "mail": {
            "protonmail": {
                "enable": true,
                "match": [{ "class": "proton-mail" }],
                "command": ["proton-mail"],
                "move": true
            }
        },
        "1password": {
            "1password": {
                "enable": true,
                "match": [{ "class": "com.onepassword.OnePassword" }],
                "command": ["1password"],
                "move": true
            }
        },
        "term": {
            "foot": {
                "enable": true,
                "match": [{ "class": "foot-scratch" }],
                "command": ["foot", "--app-id", "foot-scratch"],
                "move": true
            }
        },
        "music": {
            "spotify": { "command": ["spotify"] },
            "feishin": { "enable": false }
        },
        "sysmon": {
            "btop": { "command": ["foot", "-a", "btop", "-T", "btop", "-e", "btop"] }
        },
        "todo": {
            "todoist": { "enable": false }
        }
    }
}
