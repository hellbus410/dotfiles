term=xterm-256color
title=foot
locked-title=yes
app-id=foot
dpi-aware=yes

font=Maple Mono NF:size=14
font-bold=Maple Mono NF:size=14
font-italic=Maple Mono NF:size=14
font-bold-italic=Maple Mono NF:size=14

[cursor]
style=beam

[mouse]
hide-when-typing=yes

[scrollback]
lines=20000

[colors-dark]
alpha=0.9

# Colours follow the Caelestia scheme, generated from ~/.config/caelestia/templates/foot.ini
[main]
include=~/.local/state/caelestia/theme/foot.ini
